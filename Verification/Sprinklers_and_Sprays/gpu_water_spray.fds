&HEAD CHID='gpu_water_spray', TITLE='GPU check: water spray over a burner, two meshes' /

&MESH IJK=16,16,16, XB=0.0,4.0,0.0,4.0,0.0,4.0 /
&MESH IJK=16,16,16, XB=4.0,8.0,0.0,4.0,0.0,4.0 /

&TIME T_END=15. /
&DUMP DT_DEVC=0.25, DT_HRR=0.25 /

&SPEC ID='WATER VAPOR' /
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /

&SURF ID='burner', HRRPUA=1000., TAU_Q=-2. /
&VENT XB=3.5,4.5,1.5,2.5,0.0,0.0, SURF_ID='burner' /

&PART ID='water drops', SPEC_ID='WATER VAPOR', DIAMETER=500., AGE=20., SAMPLING_FACTOR=5 /
&PROP ID='nozzle', PART_ID='water drops', FLOW_RATE=20., PARTICLE_VELOCITY=5., SPRAY_ANGLE=0.,45., PARTICLES_PER_SECOND=2000 /
&DEVC ID='spray', XYZ=4.1,2.0,3.8, PROP_ID='nozzle', QUANTITY='TIME', SETPOINT=5. /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /

&DEVC ID='T1', QUANTITY='TEMPERATURE', XYZ=4.0,2.0,3.0 /
&DEVC ID='T2', QUANTITY='TEMPERATURE', XYZ=5.0,2.0,3.5 /
&DEVC ID='T3', QUANTITY='TEMPERATURE', XYZ=2.5,2.0,3.5 /
&DEVC ID='H2O', QUANTITY='VOLUME FRACTION', SPEC_ID='WATER VAPOR', XB=0.,8.,0.,4.,0.,4., SPATIAL_STATISTIC='VOLUME MEAN' /
&DEVC ID='U out', QUANTITY='U-VELOCITY', XB=8.0,8.0,0.0,4.0,0.0,4.0, SPATIAL_STATISTIC='AREA INTEGRAL' /

&TAIL /
