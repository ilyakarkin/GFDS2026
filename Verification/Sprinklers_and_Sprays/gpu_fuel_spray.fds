&HEAD CHID='gpu_fuel_spray', TITLE='GPU check: burning liquid fuel spray from a nozzle, two meshes, exhaust fan' /

&MESH IJK=16,16,16, XB=0.0,4.0,0.0,4.0,0.0,4.0 /
&MESH IJK=16,16,16, XB=4.0,8.0,0.0,4.0,0.0,4.0 /

&TIME T_END=10. /
&DUMP DT_DEVC=0.25, DT_HRR=0.25 /

&SPEC ID='N-HEPTANE' /
&REAC FUEL='N-HEPTANE', SOOT_YIELD=0.02, CO_YIELD=0.01 /

&PART ID='fuel drops', SPEC_ID='N-HEPTANE', DIAMETER=100., MONODISPERSE=.TRUE., AGE=20., SAMPLING_FACTOR=5 /
&PROP ID='nozzle', PART_ID='fuel drops', FLOW_RATE=2.0, PARTICLE_VELOCITY=8., SPRAY_ANGLE=0.,20.,
      PARTICLES_PER_SECOND=2000, OFFSET=0.05 /
&DEVC ID='nozzle', XYZ=3.6,2.0,1.0, PROP_ID='nozzle', QUANTITY='TIME', SETPOINT=0., ORIENTATION=1.,0.,0. /

&SURF ID='igniter', HRRPUA=500., RAMP_Q='ign' /
&RAMP ID='ign', T=0., F=1. /
&RAMP ID='ign', T=3., F=1. /
&RAMP ID='ign', T=4., F=0. /
&OBST XB=4.0,4.5,1.5,2.5,0.0,0.5, SURF_IDS='igniter','INERT','INERT' /

&SURF ID='fan', VOLUME_FLOW=2.0 /
&VENT XB=7.0,8.0,1.5,2.5,4.0,4.0, SURF_ID='fan' /
&VENT MB='XMIN', SURF_ID='OPEN' /

&DEVC ID='T1', QUANTITY='TEMPERATURE', XYZ=5.0,2.0,2.0 /
&DEVC ID='T2', QUANTITY='TEMPERATURE', XYZ=6.0,2.0,3.5 /
&DEVC ID='T3', QUANTITY='TEMPERATURE', XYZ=3.0,2.0,3.5 /
&DEVC ID='VIS', QUANTITY='VISIBILITY', XYZ=6.0,2.0,3.5 /
&DEVC ID='fan V', QUANTITY='NORMAL VELOCITY', SURF_ID='fan', SPATIAL_STATISTIC='SURFACE INTEGRAL' /
&DEVC ID='fan M', QUANTITY='MASS FLUX WALL', SURF_ID='fan', SPATIAL_STATISTIC='SURFACE INTEGRAL' /
&DEVC ID='U open', QUANTITY='U-VELOCITY', XB=0.0,0.0,0.0,4.0,0.0,4.0, SPATIAL_STATISTIC='AREA INTEGRAL' /
&DEVC ID='fuel', QUANTITY='MASS FRACTION', SPEC_ID='N-HEPTANE', XB=0.,8.,0.,4.,0.,4., SPATIAL_STATISTIC='VOLUME MEAN' /

&TAIL /
