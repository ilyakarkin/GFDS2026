&HEAD CHID='gpu_output_quantities', TITLE='GPU check: SLCF, BNDF and DEVC output quantities of smoke-control models' /

Two meshes with an interface through the room, a sooty fire, a mechanical exhaust with a RAMP,
an open supply and a thermally thick steel plate. Every output is written as DEVC, SLCF and BNDF,
so the GPU (--g) can be compared with FDS 6.11.1 and with the CPU path (--c) of the same build.

&MESH IJK=20,20,20, XB=0.0,2.0,0.0,2.0,0.0,2.0 /
&MESH IJK=20,20,20, XB=2.0,4.0,0.0,2.0,0.0,2.0 /

&TIME T_END=5. /
&DUMP DT_DEVC=0.1, DT_HRR=0.1, DT_SLCF=0.5, DT_BNDF=0.5 /

&REAC FUEL='PROPANE', SOOT_YIELD=0.02, CO_YIELD=0.01 /

&MATL ID='STEEL', DENSITY=7850., CONDUCTIVITY=45., SPECIFIC_HEAT=0.46, EMISSIVITY=0.9 /
&SURF ID='PLATE', MATL_ID='STEEL', THICKNESS=0.005, COLOR='GRAY' /
&SURF ID='BURNER', HRRPUA=1000., RAMP_Q='fire', COLOR='RED' /
&RAMP ID='fire', T=0., F=0. /
&RAMP ID='fire', T=2., F=1. /
&SURF ID='EXH', VOLUME_FLOW=0.4, RAMP_V='exh', COLOR='BLUE' /
&RAMP ID='exh', T=0., F=0. /
&RAMP ID='exh', T=1., F=1. /

&OBST ID='burner', XB=0.8,1.2,0.8,1.2,0.0,0.2, SURF_IDS='BURNER','INERT','INERT' /
&OBST ID='plate', XB=3.0,3.1,0.4,1.6,0.2,1.6, SURF_ID='PLATE' /
&VENT ID='exhaust', XB=3.4,3.8,0.8,1.2,2.0,2.0, SURF_ID='EXH' /
&VENT MB='XMIN', SURF_ID='OPEN' /

Gas-phase point devices
&DEVC ID='T',      XYZ=1.0,1.0,1.5, QUANTITY='TEMPERATURE' /
&DEVC ID='T_if',   XYZ=2.0,1.0,1.7, QUANTITY='TEMPERATURE' /
&DEVC ID='rho',    XYZ=1.0,1.0,1.5, QUANTITY='DENSITY' /
&DEVC ID='rho_O2', XYZ=1.0,1.0,1.5, QUANTITY='DENSITY', SPEC_ID='OXYGEN' /
&DEVC ID='rho_CO', XYZ=1.0,1.0,1.5, QUANTITY='DENSITY', SPEC_ID='CARBON MONOXIDE' /
&DEVC ID='rho_CO2',XYZ=1.0,1.0,1.5, QUANTITY='DENSITY', SPEC_ID='CARBON DIOXIDE' /
&DEVC ID='vis',    XYZ=2.5,1.0,1.7, QUANTITY='VISIBILITY' /
&DEVC ID='od',     XYZ=2.5,1.0,1.7, QUANTITY='OPTICAL DENSITY' /
&DEVC ID='ext',    XYZ=2.5,1.0,1.7, QUANTITY='EXTINCTION COEFFICIENT' /
&DEVC ID='Ysoot',  XYZ=2.5,1.0,1.7, QUANTITY='MASS FRACTION', SPEC_ID='SOOT' /
&DEVC ID='XCO',    XYZ=2.5,1.0,1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&DEVC ID='FED',    XYZ=2.5,1.0,1.7, QUANTITY='FED' /
&DEVC ID='qr_dn',  XYZ=1.0,1.0,1.9, QUANTITY='RADIATIVE HEAT FLUX GAS', ORIENTATION=0.0,0.0,-1.0 /
&DEVC ID='qr_x',   XYZ=2.5,1.0,0.5, QUANTITY='RADIATIVE HEAT FLUX GAS', ORIENTATION=-1.0,0.0,0.0 /
&DEVC ID='hrrpuv', XYZ=1.0,1.0,0.5, QUANTITY='HRRPUV' /
&DEVC ID='p',      XYZ=2.5,1.0,1.0, QUANTITY='PRESSURE' /
&DEVC ID='pabs',   XYZ=2.5,1.0,1.0, QUANTITY='ABSOLUTE PRESSURE' /
&DEVC ID='pideal', XYZ=2.5,1.0,1.0, QUANTITY='IDEAL GAS PRESSURE' /
&DEVC ID='vel',    XYZ=1.0,1.0,1.5, QUANTITY='VELOCITY' /
&DEVC ID='w',      XYZ=1.0,1.0,1.5, QUANTITY='W-VELOCITY' /
&DEVC ID='nu',     XYZ=1.0,1.0,1.5, QUANTITY='KINEMATIC VISCOSITY' /
&DEVC ID='mu_dns', XYZ=1.0,1.0,1.5, QUANTITY='MOLECULAR VISCOSITY' /
&DEVC ID='eps',    XYZ=1.0,1.0,1.5, QUANTITY='DISSIPATION RATE' /
&DEVC ID='eta',    XYZ=1.0,1.0,1.5, QUANTITY='KOLMOGOROV LENGTH SCALE' /
&DEVC ID='re_c',   XYZ=1.0,1.0,1.5, QUANTITY='CELL REYNOLDS NUMBER' /
&DEVC ID='wci',    XYZ=0.3,1.0,0.5, QUANTITY='WIND CHILL INDEX' /

Gas-phase statistics
&DEVC ID='vis_mean', XB=0.0,4.0,0.0,2.0,1.4,1.8, QUANTITY='VISIBILITY', SPATIAL_STATISTIC='VOLUME MEAN' /
&DEVC ID='T_max',    XB=0.0,4.0,0.0,2.0,0.0,2.0, QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX' /
&DEVC ID='O2_min',   XB=0.0,4.0,0.0,2.0,0.0,2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN', SPATIAL_STATISTIC='MIN' /
&DEVC ID='perr',     XB=0.0,4.0,0.0,2.0,0.0,2.0, QUANTITY='PRESSURE POISSON RESIDUAL', SPATIAL_STATISTIC='MAX' /
&DEVC ID='T_mean_old', XB=2.2,3.8,0.2,1.8,1.2,1.9, QUANTITY='GAS TEMPERATURE', STATISTICS='MEAN' /

Wall devices: exhaust vent and steel plate
&DEVC ID='mdot_exh', XB=3.4,3.8,0.8,1.2,2.0,2.0, QUANTITY='MASS FLUX WALL', SURF_ID='EXH', SPATIAL_STATISTIC='SURFACE INTEGRAL' /
&DEVC ID='vn_exh',   XB=3.4,3.8,0.8,1.2,2.0,2.0, QUANTITY='NORMAL VELOCITY', SURF_ID='EXH', SPATIAL_STATISTIC='SURFACE INTEGRAL' /
&DEVC ID='vn_pt',    XYZ=3.6,1.0,2.0, IOR=-3, QUANTITY='NORMAL VELOCITY' /
&DEVC ID='q_net_mean', XB=3.0,3.0,0.4,1.6,0.2,1.6, IOR=-1, QUANTITY='NET HEAT FLUX', SPATIAL_STATISTIC='MEAN' /
&DEVC ID='q_net_max',  XB=3.0,3.0,0.4,1.6,0.2,1.6, IOR=-1, QUANTITY='NET HEAT FLUX', SPATIAL_STATISTIC='MAX' /
&DEVC ID='q_net',  XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='NET HEAT FLUX' /
&DEVC ID='q_inc',  XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='INCIDENT HEAT FLUX' /
&DEVC ID='q_rad',  XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='RADIATIVE HEAT FLUX' /
&DEVC ID='q_con',  XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='CONVECTIVE HEAT FLUX' /
&DEVC ID='q_gauge',XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='GAUGE HEAT FLUX' /
&DEVC ID='T_w',    XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='WALL TEMPERATURE' /
&DEVC ID='T_back', XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='BACK WALL TEMPERATURE' /
&DEVC ID='T_ast',  XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='ADIABATIC SURFACE TEMPERATURE' /
&DEVC ID='T_g_w',  XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='GAS TEMPERATURE' /
&DEVC ID='htc',    XYZ=3.0,1.0,1.0, IOR=-1, QUANTITY='HEAT TRANSFER COEFFICIENT' /

Slices: the interface plane x=2 lies in the PBY slice
&SLCF PBY=1.0, QUANTITY='TEMPERATURE', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='VELOCITY', VECTOR=T /
&SLCF PBY=1.0, QUANTITY='VISIBILITY' /
&SLCF PBY=1.0, QUANTITY='OPTICAL DENSITY' /
&SLCF PBY=1.0, QUANTITY='DENSITY' /
&SLCF PBY=1.0, QUANTITY='DENSITY', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBY=1.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBY=1.0, QUANTITY='HRRPUV', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='PRESSURE' /
&SLCF PBY=1.0, QUANTITY='ABSOLUTE PRESSURE', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='PRESSURE POISSON RESIDUAL', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='KINEMATIC VISCOSITY', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='INTEGRATED INTENSITY', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='DHDX', CELL_CENTERED=T /
&SLCF PBY=1.0, QUANTITY='DHDZ', CELL_CENTERED=T /
&SLCF PBZ=1.7, QUANTITY='VISIBILITY' /
&SLCF PBZ=1.7, QUANTITY='TEMPERATURE' /

Boundary files
&BNDF QUANTITY='RADIATIVE HEAT FLUX' /
&BNDF QUANTITY='NET HEAT FLUX' /
&BNDF QUANTITY='INCIDENT HEAT FLUX' /
&BNDF QUANTITY='CONVECTIVE HEAT FLUX' /
&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='ADIABATIC SURFACE TEMPERATURE' /
&BNDF QUANTITY='GAUGE HEAT FLUX' /

&TAIL /
